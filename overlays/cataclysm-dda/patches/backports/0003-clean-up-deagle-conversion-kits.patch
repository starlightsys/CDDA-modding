+    "mod_targets": [ "modular_deagle" ],
     "install_time": "2 m",
     "ammo_modifier": [ "357mag" ],
     "magazine_adaptor": [ [ "357mag", [ "deaglemag_357" ] ] ],
@@ -889,7 +889,7 @@
     "symbol": ":",
     "color": "yellow",
     "location": "bore",
-    "mod_targets": [ "modular_deagle", "modular_deagle_357", "modular_deagle_44", "modular_deagle_50" ],
